{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "splitsnap",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SplitSession"
      }
    ]
  },
  "exports": {
    "SplitSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash"
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE",
      "namespace_id": "101001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RECEIPT_RATE",
      "namespace_id": "101002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "AI_GLOBAL_RATE",
      "namespace_id": "101003",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
